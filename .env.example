# Dashboard data source mode: mock | offline | backend
VITE_DASHBOARD_DATA_MODE=backend

# Base URL for backend HTTP API (used in backend mode)
VITE_DASHBOARD_API_BASE_URL=http://127.0.0.1:8090

# WebSocket endpoint for dashboard telemetry (used in backend mode)
VITE_DASHBOARD_WS_URL=ws://127.0.0.1:8765

# Local field-network access token for the backend control POST endpoints
# (/api/model, /api/tracker, /api/target). Required only when the Pi dashboard
# API is bound to a non-loopback interface; leave empty for loopback use.
# Consumed only by tools/start_dashboard.sh, which injects it into the session
# runtime-config; the app never reads it as a build-time value.
VITE_DASHBOARD_CONTROL_TOKEN=
