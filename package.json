{
  "name": "micro-uav-dashboard-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.config.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.config.{ts,js}\"",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build": "vite build",
    "generated:check": "bash tools/check_generated_artifacts.sh",
    "smoke": "bash tools/smoke_dashboard.sh",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run generated:check && npm run smoke",
    "preview": "vite preview"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "postcss": "^8.4.47",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.69.0",
    "vite": "^5.4.8",
    "vitest": "3.2.7"
  }
}
